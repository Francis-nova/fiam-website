# Zoho ZeptoMail "Send Mail token" (Agents > your agent > SMTP/API tab)
ZEPTOMAIL_TOKEN=
# Must be an address on a domain verified in ZeptoMail (default support@usefiam.com)
ZEPTOMAIL_FROM=support@usefiam.com
# Where messages are delivered (default support@usefiam.com)
CONTACT_TO=support@usefiam.com
# Only change for other Zoho regions, e.g. https://api.zeptomail.eu/v1.1/email
ZEPTOMAIL_API=https://api.zeptomail.com/v1.1/email
