# Zoho ZeptoMail "Send Mail token" (Agents > your agent > SMTP/API tab)
ZEPTOMAIL_TOKEN=
# Must be an address on a domain verified in ZeptoMail (default hello@usefiam.com)
ZEPTOMAIL_FROM=hello@usefiam.com
# Where messages are delivered (default hello@usefiam.com)
CONTACT_TO=hello@usefiam.com
# Only change for other Zoho regions, e.g. https://api.zeptomail.eu/v1.1/email
ZEPTOMAIL_API=https://api.zeptomail.com/v1.1/email

# Brevo API key (SMTP & API > API Keys). Real value goes in .env.local, never here.
BREVO_API_KEY=
# Brevo list IDs for the iPhone waitlist, crypto early access and the newsletter popup
BREVO_WAITLIST_LIST_ID=6
BREVO_CRYPTO_LIST_ID=7
BREVO_NEWSLETTER_LIST_ID=8

# Cloudflare Turnstile bot check on all forms (Cloudflare dashboard > Turnstile > Add widget).
# Site key is public; secret key is server-only. Without a secret key, production forms refuse to submit.
# Test keys that always pass: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis for form rate limiting across Vercel instances (Vercel > Storage > Upstash for Redis
# sets these automatically). Without them, limits are per instance and much weaker.
KV_REST_API_URL=
KV_REST_API_TOKEN=
